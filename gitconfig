[user]
	name = David Dunn
	email = 26876072+doubledup@users.noreply.github.com
[core]
	editor = nvim
	pager = delta
	ignorecase = true
	excludesfile = ~/.gitignore

[color]
	ui = auto
[commit]
	gpgsign = true
[diff]
	algorithm = histogram
	colorMoved = default
[diff "lockb"]
	textconv = bun
	binary = true
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = diff3
[pull]
	ff = only

# Catppuccin flavours as features from the vendored upstream port: fish's conf.d/theme.fish selects
# one through DELTA_FEATURES, which replaces `features`. Keys in [delta] outrank a feature's, so
# [delta] holds no colour keys.
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[delta]
	features = catppuccin-mocha
	hyperlinks = true
	line-numbers = true
	navigate = true
	paging = always
[ghq]
	root = ~/code/src
[github]
	user = doubledup
[rerere]
	enabled = true
