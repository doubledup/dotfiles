{
    "permissions": {
        "defaultMode": "auto",
        "allow": [
            "Bash(command -v:*)",
            "Bash(gh pr checks:*)",
            "Bash(gh pr diff:*)",
            "Bash(gh pr view:*)",
            "Bash(gh run list:*)",
            "Bash(gh run view:*)",
            "Bash(git commit:*)",
            "WebFetch(domain:code.claude.com)",
            "WebFetch(domain:docs.claude.com)",
            "mcp__claude_ai_Atlassian_MCP__atlassianUserInfo",
            "mcp__claude_ai_Atlassian_MCP__getAccessibleAtlassianResources",
            "mcp__claude_ai_Atlassian_MCP__getConfluenceContent",
            "mcp__claude_ai_Atlassian_MCP__getJiraIssue",
            "mcp__claude_ai_Atlassian_MCP__search",
            "mcp__claude_ai_Atlassian_MCP__searchConfluence",
            "mcp__claude_ai_Atlassian_MCP__searchJiraIssuesUsingJql"
        ],
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(**/.envrc)",
            "Read(**/*.envrc.*)",
            "Read(**/dumps/**)",
            "Read(~/.aws/**)",
            "Read(~/.ssh/**)",
            "Read(~/.gnupg/**)",
            "Read(~/.config/gh/**)",
            "Read(~/.git-credentials)",
            "Edit(~/.gitconfig)",
            "Edit(~/.config/git/config)",
            "Edit(~/.ssh/**)",
            "Edit(~/.aws/**)",
            "Edit(~/.gnupg/**)",
            "Bash(*/.env*)",
            "Bash(* .env*)",
            "Bash(*.envrc*)",
            "Bash(*/dumps/*)",
            "Bash(*/.aws/*)",
            "Bash(*/.ssh/*)",
            "Bash(*/.gnupg/*)",
            "Bash(*/.config/gh/*)",
            "Bash(*.git-credentials*)",
            "Bash(aws configure export-credentials:*)",
            "Bash(aws * export-credentials*)",
            "Bash(sudo:*)",
            "Bash(rm -r*)",
            "Bash(rm -R*)",
            "Bash(rm -fr*)",
            "Bash(rm -fR*)",
            "Bash(rm * -r*)",
            "Bash(rm * -R*)",
            "Bash(rm * -fr*)",
            "Bash(rm * -fR*)",
            "Bash(git clean:*)",
            "Bash(git commit --no-veri*)",
            "Bash(git commit * --no-veri*)",
            "Bash(git push --no-veri*)",
            "Bash(git push * --no-veri*)",
            "Bash(git push --forc*)",
            "Bash(git push * --forc*)",
            "Bash(git push -f*)",
            "Bash(git push * -f*)",
            "Bash(git push * +*)",
            "Bash(git push --m*)",
            "Bash(git push * --m*)",
            "Bash(git push --de*)",
            "Bash(git push * --de*)",
            "Bash(git push -d*)",
            "Bash(git push * -d*)",
            "Bash(git push * :**)",
            "Bash(git -C * push*)",
            "Bash(gh repo delete:*)",
            "Bash(gh repo archive:*)",
            "Bash(gh repo edit *--visibility*)",
            "Bash(gh api -X DELETE*)",
            "Bash(gh api *-X DELETE*)",
            "Bash(gh api --method DELETE*)",
            "Bash(gh api *--method DELETE*)",
            "Bash(terraform destroy:*)",
            "Bash(terraform * destroy*)",
            "Bash(aws s3 rm:*)",
            "Bash(aws s3 rb:*)",
            "Bash(aws * delete-*)",
            "Bash(aws * purge-*)",
            "Bash(aws * terminate-*)",
            "mcp__claude_ai_Atlassian_MCP__executeDestructive"
        ],
        "ask": [
            "Edit(**/CLAUDE.md)",
            "Edit(**/CLAUDE.local.md)",
            "Edit(**/.claude/settings.json)",
            "Edit(**/.claude/settings.local.json)",
            "Edit(**/.claude/hooks/**)",
            "Edit(**/.claude/skills/**)",
            "Edit(**/.claude/agents/**)",
            "Edit(**/.claude/commands/**)",
            "Edit(**/.claude/rules/**)",
            "Edit(**/.mcp.json)",
            "Edit(**/.pre-commit-config.yaml)",
            "Bash(*--profile*prd*)",
            "Bash(*--profile*prod*)",
            "Bash(*--profile*ppe*)",
            "Bash(*_PROFILE=*prd*)",
            "Bash(*_PROFILE=*prod*)",
            "Bash(*_PROFILE=*ppe*)",
            "Bash(terraform apply:*)"
        ]
    },
    "autoMode": {
        "environment": [
            "$defaults",
            "**Production cloud accounts**: AWS profiles whose names contain prd, prod or production are production; using one is a Production Read or Production Deploy",
            "**Sensitive data locations & audiences**: production DynamoDB tables, SQS dead-letter queues, Kinesis streams and database dumps. They hold customer personal information; work uses synthetic data only. Logs, traces and RUM sessions (CloudWatch, Datadog) carry no personal information by design and are routine debugging sources",
            "**Personal information**: customer names, ID and passport numbers, phone numbers, email and postal addresses, bank details and dates of birth are personal information under POPIA. Reading them from any store, or copying them into code, fixtures, commits, tickets, PR text or messages, is a data exfiltration risk even in non-production accounts",
            "**Credentials**: a script or command that reads ~/.aws, ~/.ssh, ~/.gnupg, ~/.config/gh, .env or .envrc files, or prints their contents, is credential access unless the user asked for it"
        ]
    }
}
