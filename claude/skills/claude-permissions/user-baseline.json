{
    "permissions": {
        "defaultMode": "auto",
        "allow": [
            "Bash(command -v:*)",
            "Bash(gh pr checks:*)",
            "Bash(gh pr diff:*)",
            "Bash(gh pr view:*)",
            "Bash(gh run list:*)",
            "Bash(gh run view:*)",
            "Bash(git commit:*)",
            "WebFetch(domain:code.claude.com)",
            "WebFetch(domain:docs.claude.com)",
            "mcp__claude_ai_Atlassian_MCP__atlassianUserInfo",
            "mcp__claude_ai_Atlassian_MCP__getAccessibleAtlassianResources",
            "mcp__claude_ai_Atlassian_MCP__getConfluenceContent",
            "mcp__claude_ai_Atlassian_MCP__getJiraIssue",
            "mcp__claude_ai_Atlassian_MCP__search",
            "mcp__claude_ai_Atlassian_MCP__searchConfluence",
            "mcp__claude_ai_Atlassian_MCP__searchJiraIssuesUsingJql"
        ],
        "deny": [
            "Read(~/**/.env)",
            "Read(~/**/.env.*)",
            "Read(~/**/.envrc)",
            "Read(~/**/*.envrc.*)",
            "Read(~/**/dumps/**)",
            "Read(~/.aws/**)",
            "Read(~/.ssh/**)",
            "Read(~/.gnupg/**)",
            "Read(~/.config/gh/**)",
            "Read(~/.git-credentials)",
            "Read(~/.netrc)",
            "Read(~/.npmrc)",
            "Edit(~/.gitconfig)",
            "Edit(~/.config/git/config)",
            "Edit(~/.ssh/**)",
            "Edit(~/.aws/**)",
            "Edit(~/.gnupg/**)",
            "Edit(~/.local/share/direnv/allow/**)",
            "Bash(*/.env*)",
            "Bash(cat*.env*)",
            "Bash(head*.env*)",
            "Bash(tail*.env*)",
            "Bash(less*.env*)",
            "Bash(bat*.env*)",
            "Bash(source*.env*)",
            "Bash(cp*.env*)",
            "Bash(git commit*-F*.env*)",
            "Bash(git commit*--file*.env*)",
            "Bash(rg * .env*)",
            "Bash(grep * .env*)",
            "Bash(sed * .env*)",
            "Bash(awk * .env*)",
            "Bash(*/dumps/*)",
            "Bash(* dumps/*)",
            "Bash(*/.aws/*)",
            "Bash(*/.ssh/*)",
            "Bash(*/.netrc*)",
            "Bash(*/.npmrc*)",
            "Bash(*/.gnupg/*)",
            "Bash(*/.config/gh/*)",
            "Bash(*.git-credentials*)",
            "Bash(*export-credentials*)",
            "Bash(direnv:*)",
            "Bash(sudo:*)",
            "Bash(rm -r*)",
            "Bash(rm -R*)",
            "Bash(rm --recursive*)",
            "Bash(rm -fr*)",
            "Bash(rm -fR*)",
            "Bash(rm * -r*)",
            "Bash(rm * -R*)",
            "Bash(rm * --recursive*)",
            "Bash(rm * -fr*)",
            "Bash(rm * -fR*)",
            "Bash(find * -delete*)",
            "Bash(find -delete*)",
            "Bash(git clean:*)",
            "Bash(git -C * clean*)",
            "Bash(git worktree remove -f:*)",
            "Bash(git worktree remove * -f*)",
            "Bash(git worktree remove *--force*)",
            "Bash(git commit --no-veri*)",
            "Bash(git commit * --no-veri*)",
            "Bash(git push --no-veri*)",
            "Bash(git push * --no-veri*)",
            "Bash(git push --forc*)",
            "Bash(git push * --forc*)",
            "Bash(git push -f*)",
            "Bash(git push * -f*)",
            "Bash(git push * +*)",
            "Bash(git push --m*)",
            "Bash(git push * --m*)",
            "Bash(git push --de*)",
            "Bash(git push * --de*)",
            "Bash(git push -d*)",
            "Bash(git push * -d*)",
            "Bash(git push * :**)",
            "Bash(git push --pru*)",
            "Bash(git push * --pru*)",
            "Bash(git -C * push*)",
            "Bash(gh repo delete:*)",
            "Bash(gh repo archive:*)",
            "Bash(gh repo edit *--visibility*)",
            "Bash(gh release delete:*)",
            "Bash(gh secret delete:*)",
            "Bash(gh variable delete:*)",
            "Bash(gh api -X DELETE*)",
            "Bash(gh api *-X DELETE*)",
            "Bash(gh api -X=DELETE*)",
            "Bash(gh api *-X=DELETE*)",
            "Bash(gh api -XDELETE*)",
            "Bash(gh api *-XDELETE*)",
            "Bash(gh api --method DELETE*)",
            "Bash(gh api *--method DELETE*)",
            "Bash(gh api --method=DELETE*)",
            "Bash(gh api *--method=DELETE*)",
            "Bash(terraform destroy:*)",
            "Bash(terraform * destroy*)",
            "Bash(aws s3 rm:*)",
            "Bash(aws s3 rb:*)",
            "Bash(aws * delete-*)",
            "Bash(aws * purge-*)",
            "Bash(aws * terminate-*)",
            "mcp__claude_ai_Atlassian_MCP__executeDestructive"
        ],
        "ask": [
            "Edit(~/**/CLAUDE.md)",
            "Edit(~/**/CLAUDE.local.md)",
            "Edit(~/**/.claude/settings.json)",
            "Edit(~/**/.claude/settings.local.json)",
            "Edit(~/**/.claude/hooks/**)",
            "Edit(~/**/.claude/skills/**)",
            "Edit(~/**/.claude/agents/**)",
            "Edit(~/**/.claude/commands/**)",
            "Edit(~/**/.claude/rules/**)",
            "Edit(~/**/.mcp.json)",
            "Edit(~/**/.pre-commit-config.yaml)",
            "Edit(~/**/.githooks/**)",
            "Bash(git config*hooksPath*)",
            "Bash(git config*hookspath*)",
            "Bash(git config*fsmonitor*)",
            "Bash(*--profile*prd*)",
            "Bash(*--profile*prod*)",
            "Bash(*--profile*ppe*)",
            "Bash(*_PROFILE=*prd*)",
            "Bash(*_PROFILE=*prod*)",
            "Bash(*_PROFILE=*ppe*)",
            "Bash(terraform apply:*)"
        ]
    },
    "autoMode": {
        "environment": [
            "$defaults",
            "**Production cloud accounts**: AWS profiles whose names contain prd, prod or production are production, and ppe or preproduction profiles are pre-production; using one, by CLI flag, environment variable or SDK profile_name, is a Production Read or Production Deploy",
            "**Sensitive data locations & audiences**: production DynamoDB tables, SQS dead-letter queues, Kinesis streams and database dumps. They hold customer personal information; work uses synthetic data only. Logs, traces and RUM sessions (CloudWatch, Datadog) carry no personal information by design and are routine debugging sources",
            "**Personal information**: customer names, ID and passport numbers, phone numbers, email and postal addresses, bank details and dates of birth are personal information under POPIA. Reading them from any store, or copying them into code, fixtures, commits, tickets, PR text or messages, is a data exfiltration risk even in non-production accounts",
            "**Credentials**: a script or command that opens, prints or copies the contents of ~/.aws, ~/.ssh, ~/.gnupg, ~/.config/gh, ~/.netrc, .env or .envrc files is credential access unless the user asked for it. Using a CLI or SDK that loads a named AWS profile (aws --profile, botocore Session(profile_name=...)) is not"
        ]
    }
}
