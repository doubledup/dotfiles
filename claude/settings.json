{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(command -v:*)",
      "Bash(date)",
      "Bash(git commit:*)",
      "Bash(git symbolic-ref --short HEAD)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune)",
      "Bash(git worktree prune *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Read(//private/tmp/claude-*/**)",
      "Read(//tmp/claude-*/**)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/agents/**)",
      "Read(~/.claude/rules/**)",
      "Read(~/.claude/hooks/**)",
      "Read(~/.claude/commands/**)",
      "Read(~/.claude/docs/**)",
      "Read(~/.claude/CLAUDE.md)",
      "Read(~/.claude/settings.json)",
      "Read(~/.dotfiles/claude/**)",
      "Read(~/.claude/projects/*/memory/**)",
      "Read(~/.claude/plans/**)",
      "Edit(//private/tmp/claude-*/*)",
      "Edit(//tmp/claude-*/*)",
      "Bash(claude doctor)",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian__addWorklogToJiraIssue",
      "mcp__claude_ai_Atlassian__createIssueLink",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/*.envrc.*)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.config/gh/**)",
      "Read(**/.git-credentials)",
      "Read(~/.env)",
      "Read(~/.env.*)",
      "Read(~/.envrc)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/cloudflare/**)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.dotfiles/gitconfig)",
      "Edit(~/.config/git/config)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(**/.local/share/direnv/allow/**)",
      "Edit(~/**/.pre-commit-config.yaml)",
      "Grep",
      "Bash(sudo:*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm --recursive*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm * --recursive*)",
      "Bash(rm * -fr*)",
      "Bash(rm * -fR*)",
      "Bash(aws configure export-credentials:*)",
      "Bash(aws * export-credentials*)",
      "Bash(*--profile*prd*)",
      "Bash(*--profile*prod*)",
      "Bash(*_PROFILE=*prd*)",
      "Bash(*_PROFILE=*prod*)",
      "Bash(direnv:*)",
      "Bash(git clean:*)",
      "Bash(git -C * clean*)",
      "Bash(git push --forc*)",
      "Bash(git push * --forc*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --no-veri*)",
      "Bash(git push * --no-veri*)",
      "Bash(git push --m*)",
      "Bash(git push * --m*)",
      "Bash(git push --de*)",
      "Bash(git push * --de*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * :**)",
      "Bash(git push --pru*)",
      "Bash(git push * --pru*)",
      "Bash(git push --rece*)",
      "Bash(git push * --rece*)",
      "Bash(git push --e*)",
      "Bash(git push * --e*)",
      "Bash(git push --rep*)",
      "Bash(git push * --rep*)",
      "Bash(git push /*)",
      "Bash(git push * /*)",
      "Bash(git push ./*)",
      "Bash(git push * ./*)",
      "Bash(git push ../*)",
      "Bash(git push * ../*)",
      "Bash(git push ~*)",
      "Bash(git push * ~*)",
      "Bash(git push file:/*)",
      "Bash(git push * file:/*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(git --* push*)",
      "Bash(git rebase --ex*)",
      "Bash(git rebase * --ex*)",
      "Bash(git rebase -x*)",
      "Bash(git rebase * -x*)",
      "Bash(git fetch --upl*)",
      "Bash(git fetch * --upl*)",
      "Bash(git pull --upl*)",
      "Bash(git pull * --upl*)",
      "Bash(git worktree remove -f:*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git -C * worktree remove -f*)",
      "Bash(git -C * worktree remove * -f*)",
      "Bash(git -C * worktree remove *--force*)",
      "Bash(gh repo delete:*)",
      "Bash(terraform destroy:*)",
      "Bash(rsync:*)",
      "Bash(dd:*)",
      "Bash(*.env*)",
      "Bash(*.envrc*)",
      "Bash(*/secrets/*)",
      "Bash(*/.aws/*)",
      "Bash(*/.ssh/*)",
      "Bash(*/.gnupg/*)",
      "Bash(*/.config/gh/*)",
      "Bash(*.git-credentials*)",
      "Read(**/dumps/**)",
      "Bash(*dumps/*)",
      "Bash(* dumps)",
      "Bash(* dumps *)",
      "Bash(*/dumps)",
      "Bash(*/dumps *)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -delete*)",
      "Bash(find * -fprint*)",
      "Bash(find * -fls*)",
      "Bash(find -exec*)",
      "Bash(find -ok*)",
      "Bash(find -delete*)",
      "Bash(find -fprint*)",
      "Bash(find -fls*)"
    ],
    "ask": [
      "mcp__*atadog*__*log*",
      "mcp__*atadog*__*trace*",
      "mcp__*atadog*__*span*",
      "mcp__*atadog*__*rum*",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(terraform apply:*)",
      "Bash(just deploy:*)",
      "mcp__claude_ai_Atlassian__createConfluencePage",
      "mcp__claude_ai_Atlassian__updateConfluencePage",
      "mcp__claude_ai_Atlassian__createConfluenceFooterComment",
      "mcp__claude_ai_Atlassian__createConfluenceInlineComment",
      "mcp__claude_ai_Atlassian__addTeamworkGraphContext",
      "mcp__claude_ai_Atlassian__createCompassComponent",
      "mcp__claude_ai_Atlassian__createCompassComponentRelationship",
      "mcp__claude_ai_Atlassian__createCompassCustomFieldDefinition"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/code/worktrees",
      "~/.dotfiles"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gh-api-readonly.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/commit-alone.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-create.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "**Production cloud accounts**: AWS profiles whose names contain prd, prod or production are production; using one is a Production Read or Production Deploy",
      "**Sensitive data locations & audiences**: production DynamoDB tables, SQS dead-letter queues, Kinesis streams, CloudWatch and Datadog logs, traces and RUM sessions, log exports and database dumps. They hold customer personal information; work uses synthetic data only"
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "objects.githubusercontent.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.local/share/nvim",
        "~/.local/state/nvim",
        "~/.cache/nvim"
      ],
      "denyWrite": [
        "~/**/.git/hooks",
        "~/**/.git/config",
        "~/.gitconfig",
        "~/.dotfiles/gitconfig",
        "~/.config/git/config",
        "~/.dotfiles/.githooks",
        "~/.dotfiles/claude/hooks",
        "~/.dotfiles/claude/skills",
        "~/.dotfiles/claude/rules",
        "~/.dotfiles/justfile",
        "~/.dotfiles/scripts"
      ],
      "denyRead": [
        "~/.env",
        "~/.envrc"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.config/cloudflare",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "gh *",
      "rcup *",
      "rcdn *",
      "mkrc *",
      "git commit *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git push",
      "git push origin",
      "git push origin *",
      "git push -u origin",
      "git push -u origin *",
      "git push --set-upstream origin",
      "git push --set-upstream origin *",
      "git rebase *",
      "git merge *",
      "git cherry-pick *",
      "git revert *",
      "git worktree remove *",
      "git worktree prune",
      "git worktree prune *",
      "git branch -d *",
      "git branch -D *"
    ]
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
