      "mcp__claude_ai_Atlassian__createCompassComponentRelationship",
      "mcp__claude_ai_Atlassian__createCompassCustomFieldDefinition"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/code/worktrees"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gh-api-readonly.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/config-docs.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": false
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "objects.githubusercontent.com",
        "api.datadoghq.eu"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.local/share/nvim",
        "~/.local/state/nvim",
        "~/.cache/nvim"
      ],
      "denyWrite": ["~/**/.git/hooks"],
      "denyRead": ["~/.env", "~/.envrc"]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "gh *",
      "rcup *",
      "rcdn *",
      "mkrc *",
      "git commit *",
      "git rebase *",
      "git merge *",
      "git cherry-pick *",
      "git revert *",
      "just push",
      "just push *"
    ]
  },
  "tui": "default",
  "skipWorkflowUsageWarning": false
}
