#!/usr/bin/env bash

set -euo pipefail

check_broken_symlinks() {
    local search_dir="$HOME"
    local remove_broken=false
    local into=""

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case $1 in
        -r | --remove)
            remove_broken=true
            shift
            ;;
        --into)
            into="${2%/}"
            shift 2
            ;;
        *)
            search_dir="$1"
            shift
            ;;
        esac
    done

    echo "Checking for broken symlinks in $search_dir..."
    echo

    local broken_symlinks
    broken_symlinks=$(
        fd . "$search_dir" --type symlink --hidden \
            --exclude ".cache" \
            --exclude "Library/" \
            --exclude "code/" \
            2>/dev/null |
            while IFS= read -r symlink; do
                if [[ -L "$symlink" ]] && [[ ! -e "$symlink" ]] &&
                    [[ -z "$into" || "$(readlink "$symlink")" == "$into"/* ]]; then
                    echo "$symlink"
                fi
            done
    )

    if [[ -n "$broken_symlinks" ]]; then
        echo "Found broken symlinks:"
        echo "$broken_symlinks" | while IFS= read -r symlink; do
            echo "  $symlink -> $(readlink "$symlink")"
        done
        echo

        if [[ "$remove_broken" == true ]]; then
            echo "Removing broken symlinks..."
            local rc=0
            while IFS= read -r symlink; do
                if rm "$symlink" 2>/dev/null; then
                    echo "  Removed: $symlink"
                else
                    echo "  Failed to remove: $symlink"
                    rc=1
                fi
            done <<<"$broken_symlinks"
            return $rc
        else
            echo "To clean up broken symlinks, use the --remove flag"
        fi
    else
        echo "No broken symlinks found"
    fi
}

main() {
    check_broken_symlinks "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
